{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["**/*.csproj"]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["index.md", "fai-api-notes.md", "library-template.md", "toc.yml"]
      },
      {
        "src": "..",
        "files": ["README.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "AlfaVision.FaiLicence",
      "_appTitle": "AlfaVision.FaiLicence",
      "_appFooter": "© AlfaVision · MIT",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/arneboye/alfavision-fai-licence",
        "branch": "main"
      }
    },
    "xref": ["https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"],
    "sitemap": {
      "baseUrl": "https://arneboye.github.io/alfavision-fai-licence/"
    }
  }
}
