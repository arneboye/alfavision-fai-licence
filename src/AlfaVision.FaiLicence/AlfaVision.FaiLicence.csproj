<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AlfaVision.FaiLicence</PackageId>
    <RootNamespace>AlfaVision.FaiLicence</RootNamespace>
    <Description>Read-only client for the FAI Sporting Licences API (IGC): search licences and look up licence details. Never writes — the write endpoints of the API are blocked by design.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- Version is supplied by the publish workflow from the git tag (-p:Version=1.2.3). -->
    <Version Condition="'$(Version)' == ''">0.0.1-local</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

</Project>
