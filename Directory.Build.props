<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Ownership: everything in this repository belongs to AlfaVision. Stamped into every assembly and package. -->
  <PropertyGroup>
    <Company>AlfaVision</Company>
    <Authors>Arne Boye-Møller, AlfaVision</Authors>
    <Copyright>© $([System.DateTime]::UtcNow.Year) AlfaVision</Copyright>
    <Product>AlfaVision.FaiLicence</Product>
    <PackageProjectUrl>https://github.com/arneboye/alfavision-fai-licence</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arneboye/alfavision-fai-licence</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fai;igc;gliding;sporting-licence;licence;nac</PackageTags>
  </PropertyGroup>

  <!-- Source Link (built into the SDK for GitHub) and symbol packages, so consumers can step into the code. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
